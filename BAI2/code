    public abstract class PhuongTien
    {
        private string _maPT;
        private string _tenHang;
        private int _namSanXuat;
        private decimal _giaGoc;

        public string MaPT
        {
            get { return _maPT; }
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    _maPT = "PT000";
                else
                    _maPT = value.Trim();
            }
        }

        public string TenHang
        {
            get { return _tenHang; }
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    throw new ArgumentException("Ten hang khong duoc de trong!");

                _tenHang = value.Trim();
            }
        }

        public int NamSanXuat
        {
            get { return _namSanXuat; }
            set
            {
                if (value < 1900 || value > DateTime.Now.Year)
                    throw new ArgumentException("Nam san xuat khong hop le!");

                _namSanXuat = value;
            }
        }

        public decimal GiaGoc
        {
            get { return _giaGoc; }
            set
            {
                if (value <= 0)
                    throw new ArgumentException("Gia goc phai lon hon 0!");

                _giaGoc = value;
            }
        }

        protected PhuongTien(string maPT, string tenHang, int namSanXuat, decimal giaGoc)
        {
            MaPT = maPT;
            TenHang = tenHang;
            NamSanXuat = namSanXuat;
            GiaGoc = giaGoc;
        }

        public abstract decimal TinhGiaLanBanh();

        public virtual string LayThongTin()
        {
            return $"Ma phuong tien: {MaPT} | Hang: {TenHang} | Nam san xuat: {NamSanXuat} | Gia goc: {GiaGoc:N0}";
        }
    }

    public class OTo : PhuongTien
    {
        public int SoChoNgoi { get; set; }
        public decimal DungTichDongCo { get; set; }

        public OTo(
            string maPT,
            string tenHang,
            int namSanXuat,
            decimal giaGoc,
            int soChoNgoi,
            decimal dungTichDongCo)
            : base(maPT, tenHang, namSanXuat, giaGoc)
        {
            if (soChoNgoi <= 0)
                throw new ArgumentException("So cho ngoi phai lon hon 0!");

            if (dungTichDongCo <= 0)
                throw new ArgumentException("Dung tich dong co phai lon hon 0!");

            SoChoNgoi = soChoNgoi;
            DungTichDongCo = dungTichDongCo;
        }

        public override decimal TinhGiaLanBanh()
        {
            if (SoChoNgoi <= 9)
                return GiaGoc + GiaGoc * 0.12m + GiaGoc * 0.30m;

            return GiaGoc + GiaGoc * 0.10m;
        }

        public override string LayThongTin()
        {
            return base.LayThongTin() +$" | So cho ngoi: {SoChoNgoi} | Dung tich dong co: {DungTichDongCo}";
        }
    }

    public class XeMay : PhuongTien
    {
        public int DungTichXylanh { get; set; }

        public XeMay(
            string maPT,
            string tenHang,
            int namSanXuat,
            decimal giaGoc,
            int dungTichXylanh)
            : base(maPT, tenHang, namSanXuat, giaGoc)
        {
            if (dungTichXylanh <= 0)
                throw new ArgumentException("Dung tich xy lanh phai lon hon 0!");

            DungTichXylanh = dungTichXylanh;
        }

        public override decimal TinhGiaLanBanh()
        {
            if (DungTichXylanh < 175)
                return GiaGoc + GiaGoc * 0.02m;

            return GiaGoc + GiaGoc * 0.05m;
        }

        public override string LayThongTin()
        {
            return base.LayThongTin() +
                   $" | Dung tich xy lanh: {DungTichXylanh} cc";
        }
    }

    public class QuanLyPhuongTien
    {
        private List<PhuongTien> danhSach = new List<PhuongTien>();

        public void ThemPhuongTien(PhuongTien phuongTien)
        {
            danhSach.Add(phuongTien);
        }

        public void HienThiTatCa()
        {
            foreach (PhuongTien phuongTien in danhSach)
            {
                Console.WriteLine(phuongTien.LayThongTin());
                Console.WriteLine($"Gia lan banh: {phuongTien.TinhGiaLanBanh():N0}");
                Console.WriteLine();
            }
        }

        public PhuongTien TimPhuongTienGiaLanBanhCaoNhat()
        {
            return danhSach
                .OrderByDescending(phuongTien => phuongTien.TinhGiaLanBanh())
                .FirstOrDefault();
        }

        public List<PhuongTien> TimTheoTenHang(string tenHang)
        {
            return danhSach
                .Where(phuongTien =>
                    phuongTien.TenHang.Contains(
                        tenHang,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

